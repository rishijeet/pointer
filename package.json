{
  "name": "pointer",
  "displayName": "Pointer",
  "description": "A VS Code extension that reads chat output and modifies files accordingly.",
  "version": "1.0.0",
  "publisher": "rishijeet",
  "author": "Rishijeet Mishra",
  "repository": {
    "type": "git",
    "url": "https://github.com/rishijeet/pointer.git"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "icon": "images/pointer-icon-p.png",
  "contributes": {
    "commands": [
      {
        "command": "pointer.openChat",
        "title": "Open Pointer",
        "icon": {
          "light": "images/pointer-icon-p.png",
          "dark": "images/pointer-icon-p.png"
        }
      }
    ],
    "configuration": {
      "title": "Pointer",
      "properties": {
        "pointer.openaiApiKey": {
          "type": "string",
          "default": "",
          "description": "API key for OpenAI (required for GPT-3.5 and GPT-4)"
        },
        "pointer.anthropicApiKey": {
          "type": "string",
          "default": "",
          "description": "API key for Anthropic (required for Claude)"
        },
        "pointer.geminiApiKey": {
          "type": "string",
          "default": "",
          "description": "API key for Google Gemini"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./ && (cd src/chat-app && npm run build)",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/glob": "^8.0.0",
    "@types/mocha": "^10.0.0",
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.80.0",
    "@typescript-eslint/eslint-plugin": "^5.0.0",
    "@typescript-eslint/parser": "^5.0.0",
    "eslint": "^8.0.0",
    "glob": "^8.0.0",
    "mocha": "^10.0.0",
    "typescript": "^5.9.2",
    "vsce": "^2.15.0"
  },
  "rules": {
    "no-case-declarations": "off",
    "@typescript-eslint/no-empty-function": [
      "error",
      {
        "allow": [
          "arrowFunctions",
          "functions",
          "methods"
        ]
      }
    ]
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1"
  }
}
